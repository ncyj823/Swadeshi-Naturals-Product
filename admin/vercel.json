{
    "version": 2,
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://api.swadeshinatural.com/api/$1"
        },
        {
            "src": "/",
            "dest": "/login.html"
        },
        {
            "src": "/admin",
            "dest": "/admin.html"
        },
        {
            "src": "/admin.html",
            "dest": "/admin.html"
        },
        {
            "src": "/login",
            "dest": "/login.html"
        },
        {
            "src": "/login.html",
            "dest": "/login.html"
        },
        {
            "src": "/(.*)",
            "dest": "/login.html"
        }
    ]
}