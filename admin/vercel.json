{
    "version": 2,
    "builds": [
        {
            "src": "**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://api.swadeshinatural.com/api/$1"
        },
        {
            "src": "/(.*\\.(js|css|png|jpg|jpeg|svg|ico|json|woff|woff2|ttf))",
            "dest": "/$1"
        },
        {
            "src": "/",
            "dest": "/login.html"
        },
        {
            "src": "/admin",
            "dest": "/admin.html"
        },
        {
            "src": "/admin.html",
            "dest": "/admin.html"
        },
        {
            "src": "/login",
            "dest": "/login.html"
        },
        {
            "src": "/login.html",
            "dest": "/login.html"
        },
        {
            "src": "/(.*)",