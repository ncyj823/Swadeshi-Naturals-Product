{
    "version": 2,
    "builds": [
        {
            "src": "**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://api.swadeshinatural.com/api/$1"
        },
        {
            "src": "/",
            "dest": "/admin.html"
        },
        {
            "src": "/(.*)",
            "dest": "/admin.html"
        }
    ]
}